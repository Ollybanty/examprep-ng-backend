# Copy this file to .env and fill in the real values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development

# Database (MongoDB Atlas connection string, or a local one for development)
MONGODB_URI=mongodb://127.0.0.1:27017/examprep-ng

# Authentication
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Email: used for OTP codes, invites and notifications
# EMAIL_PROVIDER is gmail (on your laptop) or brevo (on Render, whose free plan blocks Gmail).
# EMAIL_USER is the sender address. For brevo, it must be a sender you confirmed in Brevo.
# EMAIL_APP_PASSWORD (gmail only) is a Gmail App Password (Google Account > Security > App passwords),
# not your normal Gmail password. BREVO_API_KEY (brevo only) is from Brevo > Settings > API keys.
# On your laptop, if the provider isn't set up, emails are printed in the terminal instead.
EMAIL_PROVIDER=gmail
EMAIL_USER=
EMAIL_APP_PASSWORD=
BREVO_API_KEY=
EMAIL_FROM_NAME=ExamPrep NG
# Optional: public PNG address of the email logo, about 400px wide
EMAIL_LOGO_URL=

# First admin account, created by: npm run seed:admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend addresses allowed to call the API from a browser, separated by commas.
# Each must match exactly: http or https, the host, and the port, e.g. http://localhost:5173
CORS_ORIGINS=http://localhost:3000

# The web app's address, used for links in emails (e.g. admin invites)
FRONTEND_URL=http://localhost:3000

# API docs login. The docs at /api/docs are off unless both are set. Use a strong password.
DOCS_USERNAME=
DOCS_PASSWORD=

# Past questions API (ALOC) - used only by the import script (scripts/importQuestions.js)
# Key from https://aloc.com.ng/dashboard/api-keys (starts with "aloc_"), sent as the X-API-Key header.
# The API is credit-based: question fetches cost 1 credit; subjects/coverage/years are free.
ALOC_TOKEN=
ALOC_BASE_URL=https://dev.aloc.com.ng/api/v1

# Groq (optional) - drafts explanations for admin review
GROQ_API_KEY=
